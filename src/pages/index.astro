---
import Layout from '../layouts/Layout.astro';
import { getCollection, getEntry } from 'astro:content';

const settings = await getEntry('settings', 'site');
const home = await getEntry('pages', 'home');
const galleries = (await getCollection('galleries')).filter(g => !g.data.draft).sort((a,b) => (b.data.date?.valueOf() ?? 0) - (a.data.date?.valueOf() ?? 0));
const { Content } = await home.render();

const heroEntries = await getCollection('hero');
const heroImages = heroEntries.map(e => e.data.image).filter(Boolean);
const fallbackHero = settings.data.heroImage || '/uploads/hero-placeholder.jpg';
const allHeros = heroImages.length ? heroImages : [fallbackHero];
const initialHero = allHeros[0] || fallbackHero;
---

<Layout title={settings.data.siteTitle} description={settings.data.siteDescription}>

  <section class="hero-bw" data-heros={JSON.stringify(allHeros)}>
    <img id="hero-a" src={initialHero} alt="Hero" class="hero-bw-img" loading="eager" style="opacity:1" />
    <img id="hero-b" src={initialHero} alt="" class="hero-bw-img" loading="eager" style="opacity:0" aria-hidden="true" />
    <div class="hero-bg-type" aria-hidden="true">ED</div>
    <div class="container hero-content">
      <div class="hero-copy">
        <p class="hero-kicker">{settings.data.siteDescription}</p>
        <h1 class="hero-title">{(settings.data.heroTitle ?? 'ED KNIPST').split(' ')[0]} <em>{(settings.data.heroTitle ?? 'ED KNIPST').split(' ').slice(1).join(' ')}</em></h1>
        <p class="hero-sub">{settings.data.heroText}</p>
      </div>
      <div class="hero-side">
        <div class="hero-meta">{galleries.length} galleries · {galleries.reduce((a,g)=>a+g.data.images.length,0)} images<br/><span style="text-transform:none; letter-spacing:0; color: rgba(255,255,255,0.42)">↑ scroll to explore</span></div>
      </div>
    </div>
  </section>
  <script is:inline>
    (() => {
      const s=document.querySelector('.hero-bw'),a=document.getElementById('hero-a'),b=document.getElementById('hero-b');
      if(!s||!a||!b) return;
      try{
        const heros=JSON.parse(s.dataset.heros||'[]'); if(heros.length<=1) return;
        const pick=(ex)=>{let p; do{p=heros[Math.floor(Math.random()*heros.length)]}while(p===ex); return p;};
        let active=a,inactive=b,cur=active.getAttribute('src'); inactive.src=cur;
        const xfade=(next)=>{ if(!next||next===cur) return; const t=new Image(); t.src=next; const go=()=>{ inactive.src=next; void inactive.offsetWidth; inactive.style.opacity='1'; active.style.opacity='0'; setTimeout(()=>{ const tmp=active; active=inactive; inactive=tmp; cur=next; inactive.style.opacity='0'; },950); }; if(t.complete) go(); else t.onload=go; };
        setTimeout(()=>{ const f=pick(cur); if(f!==cur) xfade(f); },800);
        setInterval(()=> xfade(pick(cur)),15000);
      }catch(e){}
    })();
  </script>

  <section class="paper-section">
    {settings.data.paperBgImage && (
      <img src={settings.data.paperBgImage} alt="" class="paper-bg" loading="lazy" aria-hidden="true" />
    )}
    <div class="paper-bg-wash" aria-hidden="true"></div>
    <div class="container paper-inner">
      <div class="intro-break">
        <div class="intro-card intro-minimal">
          <h1>{home.data.title}</h1>
          <div class="prose"><Content /></div>
        </div>
        <div class="intro-side">
          <div class="intro-index">01 — Intro<br/><span style="color: #0e0e0e">ED KNIPST</span><br/>Street, Menschen<br/>& Momente seit 2022</div>
          <div style="font-size: 0.78rem; line-height: 1.5; color: #6b6b6b;">No fuss. Just images that stayed. → <a href="#galleries" style="color:#0e0e0e; border-bottom:1px solid #0e0e0e;">View index</a></div>
        </div>
      </div>

      <div id="galleries" class="section-head">
        <h2>Selected works — broken grid</h2>
        <span>{galleries.length} galleries · full bleed where it wants to be</span>
      </div>
      <div class="grid" id="gallery-grid">
        {galleries.map(g => (
          <a href={`/galleries/${g.slug}/`} class="card">
            <img src={g.data.cover ?? g.data.images[0]?.image ?? '/uploads/hero-placeholder.jpg'} alt={g.data.title} loading="lazy" />
            <div class="card-body">
              <h3>{g.data.title}</h3>
              <div class="card-meta"><span>{g.data.images.length} images</span>{g.data.date ? ` · ${g.data.date.toLocaleDateString()}` : ''}</div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
</Layout>
