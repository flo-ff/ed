---
import '../styles/global.css';
interface Props {
  title: string;
  description?: string;
}
const { title, description } = Astro.props;
import { getEntry } from 'astro:content';
const settings = await getEntry('settings', 'site');
const siteTitle = settings?.data.siteTitle ?? 'ED KNIPST';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title} — {siteTitle}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <script is:inline src="https://identity.netlify.com/v1/netlify-identity-widget.js"></script>
  </head>
  <body>
    <header>
      <div class="container nav">
        <a href="/" class="logo">{siteTitle}</a>
        <nav class="nav-links">
          <a href="/#galleries">Index</a>
          <a href="/impressum/">Impressum</a>
        </nav>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer class="container">
      <span>© {new Date().getFullYear()} {siteTitle}</span>
      <span style="display:flex; gap:16px">
        {settings?.data.email && <a href={`mailto:${settings.data.email}`}>{settings.data.email}</a>}
        {settings?.data.instagram && <a href={settings.data.instagram} target="_blank">Instagram</a>}
        <a href="/impressum/">Impressum</a>
      </span>
    </footer>
    <script is:inline>
      if (window.netlifyIdentity) {
        window.netlifyIdentity.on("init", user => {
          if (!user) window.netlifyIdentity.on("login", () => { document.location.href = "/admin/"; });
        });
        if (window.location.hash.includes("invite_token") || window.location.hash.includes("recovery_token") || window.location.search.includes("invite_token")) window.netlifyIdentity.open();
      }
    </script>
  </body>
</html>
